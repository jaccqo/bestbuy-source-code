{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bestbuy scraper",
  "version": "../package.json",
  "identifier": "com.jacko-apps.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Best Buy Scraper Pro",
        "width": 1120,
        "height": 740,
        "minWidth": 980,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["mica"],
          "radius": 12
        },
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
 "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
   
    "icon": [
      "icons/logo.png",
      "icons/icon.icns",
      "icons/logo.ico"
    ],
    "resources": {
     "./resources/best_buy_engine.dist/": "backend/"
    },
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwRTIwQkVFQkVFNjZDNzIKUldSeWJPYSs3Z3ZpME84TWx6WGtLbWxEWlZEV3MyeFh5UndLRWFDdXVhMVg0ZmZBcGlRKzBRVnEK",
      "endpoints": [
        "https://bbscraper-proxy.vercel.app/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive" 
      }
    }
  }
}